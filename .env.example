# ==========================================
# AIStudio2API 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ==========================================

# 后台管理登录账号与密码 (远程访问后台必需)
AISTUDIO_ADMIN_USERNAME=admin
AISTUDIO_ADMIN_PASSWORD=admin123

# 客户端调用 API Key (对应 config.yaml 中的 gemini.api_key)
AISTUDIO_PROXY_API_KEY=sk-aistudio-888888

